# Staging environment template — api.staging.sayvors.com
# Copy to ~/sayvors/.env.prod on the EC2 and fill in the real values.
# NEVER commit the filled-in file (.env* is git-ignored on purpose).

# ── Database (AWS RDS) ────────────────────────────────────
# ssl=require: RDS enforces TLS; asyncpg picks it up from the URL.
# Pool sized for db.t4g.micro (~83 max connections): 2 workers x 20 = 40 max.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@forsayvors.cj46022k82r4.eu-north-1.rds.amazonaws.com:5432/sayvors_staging?ssl=require
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10

# ── Auth ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_STRONG_RANDOM
# Parent domain shared by the SPA + API so the SPA can read the CSRF cookie.
COOKIE_DOMAIN=.sayvors.com

# ── Infra (docker compose service names) ─────────────────
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Public URLs ───────────────────────────────────────────
CORS_ORIGINS=["https://staging.sayvors.com"]
FRONTEND_URL=https://staging.sayvors.com
ALLOWED_HOSTS=["api.staging.sayvors.com"]
GOOGLE_REVIEWS_REDIRECT_URI=https://api.staging.sayvors.com/api/v1/channels/google/callback
META_OAUTH_REDIRECT_URI=https://api.staging.sayvors.com/api/v1/meta/facebook/callback

# ── Integrations (copy from your local services/api/.env) ─
LOCALITH_API_KEY=
LOCALITH_BASE_URL=https://embedsocial.com/app/api
LOCALITH_ITEMS_PATH=rest/v1/items
BUSINESS_DATA_PROVIDER=localith

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REVIEWS_MOCK=false

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_CONFIG_ID=
META_SOLUTION_ID=
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=

# ── File storage: Google Cloud Storage (optional) ─────
# Empty = local disk (uploadsdata volume). To use GCS instead:
#   1. Create TWO buckets: sayvors-media (uniform PUBLIC access) and
#      sayvors-private (private). The provider fetches media photos from
#      public URLs; databank docs must never be public.
#   2. Service account with objectAdmin on both buckets; mount its JSON
#      into the api container and point GOOGLE_APPLICATION_CREDENTIALS
#      at it (secret file, never committed).
#   3. Set the bucket names below and redeploy. No migration needed.
#GCS_PUBLIC_BUCKET=sayvors-media
#GCS_PRIVATE_BUCKET=sayvors-private
#GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json

# ── Platform admin ────────────────────────────────────────
ADMIN_PASSWORD_HASH=
