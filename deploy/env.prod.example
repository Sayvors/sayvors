# Staging environment template — api.staging.sayvors.com
# Copy to ~/sayvors/.env.prod on the EC2 and fill in the real values.
# NEVER commit the filled-in file (.env* is git-ignored on purpose).

# Optional worker-loop allowlist. Leave unset to run every loop.
# If you set it, include connect-import so first-connect Google imports,
# AI draft generation and publishing run:
# WORKER_LOOPS=google-reviews-auto-reply,connect-import,post-publisher,analytics-consumer,performance-sync,messaging-rollup,meta-events-ai-replies,lead-actions,email-outbox
# IMPORTANT: if you use the allowlist, include email-outbox or queued
# transactional email (OTP, welcome, resets, billing decisions) is never sent.

# ── Database (AWS RDS) ────────────────────────────────────
# ssl=require: RDS enforces TLS; asyncpg picks it up from the URL.
# Pool sized for db.t4g.micro (~83 max connections): 2 workers x 20 = 40 max.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@<your-rds-endpoint>:5432/sayvors_staging?ssl=require
# Must match the pool_mode configured on PgBouncer when DATABASE_URL points at it.
DB_POOL_MODE=session
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10

# ── Auth ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_STRONG_RANDOM
# Session lifetime: 12h access token, 12h rotating refresh token.
JWT_ACCESS_EXPIRATION_MINUTES=720
JWT_REFRESH_EXPIRATION_HOURS=12
ACCESS_COOKIE_MAX_AGE=43200
REFRESH_COOKIE_MAX_AGE=43200
# One-time AI credit granted to every new tenant on the free-trial plan (cents).
TRIAL_CREDIT_CENTS=1000
# Credential encryption key (OAuth tokens, LLM keys, databank passwords).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHANNEL_ENCRYPTION_KEY=CHANGE_ME_STRONG_RANDOM
# Parent domain shared by the SPA + API so the SPA can read the CSRF cookie.
COOKIE_DOMAIN=.sayvors.com

# ── Infra (docker compose service names) ─────────────────
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Public URLs ───────────────────────────────────────────
CORS_ORIGINS=["https://staging.sayvors.com"]
FRONTEND_URL=https://staging.sayvors.com
# Public API origin used for tracked review-request links and unsubscribe URLs.
PUBLIC_API_URL=https://api.staging.sayvors.com
ALLOWED_HOSTS=["api.staging.sayvors.com"]
GOOGLE_REVIEWS_REDIRECT_URI=https://api.staging.sayvors.com/api/v1/channels/google/callback
META_OAUTH_REDIRECT_URI=https://api.staging.sayvors.com/api/v1/meta/facebook/callback

# ── Integrations (copy from your local services/api/.env) ─

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Both must stay false in every deployed environment. The startup validator
# refuses to boot otherwise: TESTING skips webhook signature checks and rate
# limits; GOOGLE_REVIEWS_MOCK fabricates reviews.
GOOGLE_REVIEWS_MOCK=false
TESTING=false
# Local Posts only accept a public sourceUrl. True = upload bytes into
# Google's own media store and use its googleUrl (no S3/GCS needed). Set
# false once S3_MEDIA_BUCKET / GCS_PUBLIC_BUCKET is configured to hand
# Google your own CDN URL instead.
GOOGLE_POST_MEDIA_STAGING=true

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# New Meta OAuth connections only. Existing connections keep working.
META_FACEBOOK_CONNECT_ENABLED=false
META_INSTAGRAM_CONNECT_ENABLED=false
# Must match the verify token entered in Meta Dashboard -> WhatsApp -> Configuration.
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_CONFIG_ID=
# Separate Builder config for coexistence ("Connect existing" — the merchant
# keeps their number and their own WhatsApp Business App). Empty falls back to
# META_WHATSAPP_CONFIG_ID, which silently opens the standard new-number flow.
META_WHATSAPP_COEXISTENCE_CONFIG_ID=
META_SOLUTION_ID=
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=

# ── File storage: S3 media (optional) ─────────────────
# Uses the EC2 instance profile / IAM role credential chain; do NOT put
# AWS access keys in this file. The attached role needs s3:PutObject on
# arn:aws:s3:::sayvorsstorage-221201452822-eu-north-1-an/media/*.
# public s3:GetObject for media/* (Block Public Access must permit that).
S3_MEDIA_BUCKET=sayvorsstorage-221201452822-eu-north-1-an
AWS_REGION=eu-north-1
S3_MEDIA_PUBLIC_BASE_URL=https://sayvorsstorage-221201452822-eu-north-1-an.s3.eu-north-1.amazonaws.com
# Private databank documents remain on local persistent storage unless a
# separate private S3 bucket is configured. Never point S3_DOCS_BUCKET at the
# public media bucket.
#S3_DOCS_BUCKET=

# ── File storage: Google Cloud Storage (optional alternative) ─────
# GCS bucket settings take effect for media only when S3_MEDIA_BUCKET is empty.
# For a GCS setup:
#   1. Create TWO buckets: sayvors-media (uniform PUBLIC access) and
#      sayvors-private (private). The provider fetches media photos from
#      public URLs; databank docs must never be public.
#   2. Service account with objectAdmin on both buckets; mount its JSON
#      into the api container and point GOOGLE_APPLICATION_CREDENTIALS
#      at it (secret file, never committed).
#   3. Set the bucket names below and redeploy. No migration needed.
#GCS_PUBLIC_BUCKET=sayvors-media
#GCS_PRIVATE_BUCKET=sayvors-private
#GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json

# ── Platform admin ────────────────────────────────────────
ADMIN_PASSWORD_HASH=

# Google Identity Services client id (same project as GOOGLE_CLIENT_ID).
# Leave empty to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key for the Locations map view. Restrict the key
# by HTTP referrer. Leave empty to show the "Map not connected" state.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Places API (New) key for service-area resolution and benchmark
# peers. Restrict it by IP/API; never expose it as NEXT_PUBLIC.
GOOGLE_PLACES_API_KEY=

# Dedicated Facebook Login app for user sign-in (same values as META_APP_ID/SECRET for now).
# Leave META_LOGIN_* empty to reuse the platform app.
META_LOGIN_APP_ID=
META_LOGIN_APP_SECRET=

# Facebook Login app id (same value as META_APP_ID for now).
# Leave empty to hide the "Continue with Facebook" button.
NEXT_PUBLIC_META_LOGIN_APP_ID=

# New channel connections. Existing connections keep working either way.
NEXT_PUBLIC_META_FACEBOOK_CONNECT_ENABLED=false
NEXT_PUBLIC_META_INSTAGRAM_CONNECT_ENABLED=false

# ── Observability ────────────────────────────────────────────────────────
# Release identifier reported to GlitchTip. Set per deploy (e.g. the git tag
# or short SHA) so the issue list can show whether a release reduced errors.
ENVIRONMENT=production
VERSION=

# GlitchTip is our self-hosted Sentry-compatible server. GLITCHTIP_DSN is the
# project ingest key for the api/worker; NEXT_PUBLIC_GLITCHTIP_DSN is the same
# project key for the browser (safe to expose publicly -- it can only write).
# Get both from GlitchTip -> Project -> Client Keys. Leave empty to disable.
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=

# Labels kept separate so staging errors never appear in the production list.
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=production
NEXT_PUBLIC_GLITCHTIP_RELEASE=

# Server-side (Django) secret used to sign GlitchTip sessions. Generate with
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse a value from another environment.
GLITCHTIP_SECRET_KEY=

# -- Email (Resend) ----------------------------------------
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM=Sayvors <noreply@sayvors.com>
# Svix signing secret from the Resend webhook endpoint (whsec_...).
# Without it, delivery/bounce events are rejected and suppressions stay empty.
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME
# Signs one-click unsubscribe links. Required in deployed environments:
# >= 32 chars and different from JWT_SECRET, so rotating the login key does
# not invalidate opt-out links already delivered.
EMAIL_UNSUBSCRIBE_SECRET=CHANGE_ME_STRONG_RANDOM
EMAIL_WORKER_BATCH=20
EMAIL_WORKER_CONCURRENCY=4
# Newsletter campaign expansion defaults (override only if needed).
# EMAIL_CAMPAIGN_BATCH_SIZE=500
# EMAIL_CAMPAIGN_INTERVAL_SECONDS=60
# EMAIL_CAMPAIGN_MAX_RECIPIENTS=50000
# OTP throttle (per address, in addition to per-IP limits).
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_DAILY_LIMIT=10
# Never-verified accounts are purged after this many days; the admin trace
# remains in Purged accounts.
# UNVERIFIED_ACCOUNT_TTL_DAYS=7
# Trial length used by the campaign variable {tenant_free_trial_days_left}.
# FREE_TRIAL_DAYS=14
# Per-tenant review-request email cap per rolling 24h. Protects the shared
# sending domain from a runaway campaign.
BULK_EMAIL_DAILY_LIMIT=500
