DATABASE_URL=postgresql+asyncpg://postgres:mentee@localhost:5432/sayvors
JWT_SECRET=           # Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LLM providers ─────────────────────────────────────────
# Managed exclusively from Admin → LLMs (database).
# No provider keys are read from the environment.

# ── Google Business Profile (Reviews channel) ───────────
# 1. Create OAuth client at https://console.cloud.google.com/apis/credentials
#    Application type: Web application
#    Authorized redirect URI: http://localhost:8000/api/v1/channels/google/callback
# 2. Enable APIs: Business Profile API + mybusiness API
# 3. The connected Google account MUST have a Business Profile (business.google.com)
#    with at least one location — otherwise the callback returns no_business_account.
# 4. Leave GOOGLE_REVIEWS_MOCK=true to skip OAuth and fabricate sample reviews
#    end-to-end (useful for first-time test driving without a real GBP account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REVIEWS_REDIRECT_URI=http://localhost:8000/api/v1/channels/google/callback
GOOGLE_REVIEWS_MOCK=false

# Localith temporary Google Business middleware
LOCALITH_API_KEY=
LOCALITH_BASE_URL=https://embedsocial.com/app/api
LOCALITH_ITEMS_PATH=rest/v1/items

# Analytics / business intelligence
ANALYTICS_PERFORMANCE_SYNC_INTERVAL_SECONDS=21600
ANALYTICS_PERFORMANCE_DAYS_BACK=30

# ── Meta integrations (WhatsApp / Facebook / Instagram) ───────────
# 1. Create an app at https://developers.facebook.com/apps
# 2. WhatsApp → Embedded Signup Builder → configuration → META_WHATSAPP_CONFIG_ID
#    Facebook Login for Business → configuration → META_FACEBOOK_CONFIG_ID
#    Instagram Login for Business → configuration → META_INSTAGRAM_CONFIG_ID
#    (each provider uses its own configuration id — never shared)
# 3. Configure webhook callback: https://<api-host>/api/v1/meta/webhooks
#    with META_WEBHOOK_VERIFY_TOKEN (any random string you choose).
# 4. External businesses need App Review Advanced on each permission
#    (whatsapp_business_messaging/management, pages_*, instagram_*)
#    plus Tech Provider verification for WhatsApp onboarding.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/meta/facebook/callback
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_CONFIG_ID=
META_SOLUTION_ID=
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=
# Local Meta webhook dev (ngrok): add the tunnel domain or Meta's
# deliveries get rejected by TrustedHostMiddleware (400 Invalid host header).
# Example: ALLOWED_HOSTS=["localhost","127.0.0.1","abc123.ngrok-free.app"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
