# Staging builds the API image with the repository root as the build context
# (deploy-staging.yml: context: .). The daemon receives this filtered context,
# so only the inputs services/api/Dockerfile actually copies are sent.
# Everything else — .git history, .env files, apps, docs, tests, caches and
# local tooling — stays on the build host.
#
# Keep this allowlist in step with services/api/Dockerfile.
*
!services
!services/api
!services/api/pyproject.toml
!services/api/app
!services/api/app/**
!services/api/alembic
!services/api/alembic/**
!services/api/alembic.ini
!integrations
!integrations/**

# Unignoring services/api above admits its whole subtree; re-exclude
# everything except the Dockerfile inputs. services/api/.env is the one that
# matters most — COPY never selected it, but the daemon used to receive it.
services/api/*
!services/api/pyproject.toml
!services/api/app
!services/api/app/**
!services/api/alembic
!services/api/alembic/**
!services/api/alembic.ini

# Python caches are never image inputs.
**/__pycache__
**/*.pyc

# Ops/backfill scripts are copied into the runtime image (Dockerfile line 47).
# These re-includes must come last: the `services/api/*` block above excludes
# the whole subtree, and the last matching pattern wins.
!services/api/scripts
!services/api/scripts/**
services/api/scripts/**/__pycache__
